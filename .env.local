# ============================================================
# Environment variables for smselitemovers
# Edit the values below. Nothing in this file is secret.
# These are read when the site is BUILT, so rebuild/redeploy
# after any change. On Hostinger, also add the same names and
# values under the website's Node.js > Environment variables.
# ============================================================

# PLACEHOLDER (edit if needed): the live address of the site, with
# https:// and no trailing slash. Used for the canonical link,
# share tags, schema, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://smselitemover.com

# Turns off Next.js anonymous usage telemetry during builds. Leave as 1.
NEXT_TELEMETRY_DISABLED=1
