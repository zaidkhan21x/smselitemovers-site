# ============================================================
# Environment variables for SMS Elite Mover (smselitemover.com)
# Edit the values below. Nothing in this file is secret.
# These are read when the site is BUILT, so rebuild/redeploy
# after any change. On Hostinger, also add the same names and
# values under the website's Node.js > Environment variables.
# ============================================================

# PLACEHOLDER (edit if needed): the live address of the site, with
# https:// and no trailing slash. Used for the canonical link,
# share tags, schema, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://smselitemover.com

# Turns off Next.js anonymous usage telemetry during builds. Leave as 1.
NEXT_TELEMETRY_DISABLED=1

# ------------------------------------------------------------
# Contact form delivery (/api/lead)
#
# These are deliberately NOT set here, because this file is in the
# repository and SMTP_PASS is a password. They are set on Hostinger
# under the website's Node.js > Environment variables, and are read
# at run time, so changing them needs a restart, not a rebuild:
#
#   SMTP_HOST   smtp.hostinger.com
#   SMTP_PORT   465
#   SMTP_USER   contact@smselitemover.com
#   SMTP_PASS   that mailbox's password
#   LEAD_TO     where leads are delivered (defaults to SMTP_USER)
#
# With them missing, /api/lead answers 500 and the form shows its
# "that didn't send, please call" message instead of losing the lead
# silently. Never commit SMTP_PASS to this file.
# ------------------------------------------------------------
